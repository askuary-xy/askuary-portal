ADMIN_TOKEN=replace-with-long-random-ascii-token
PORT=8787
NODE_ENV=production
# 相对路径相对 schema.prisma（api/prisma/）解析 → 实际文件在 api/data/
# Docker 部署时由 compose 覆盖为 file:/app/data/askuary.db
DATABASE_URL="file:../data/askuary.db"
# 生产必须填写；留空将拒绝跨域（开发 NODE_ENV!=production 时仍可本机调试）
CORS_ORIGINS=https://www.askuary.cn,https://askuary.cn
# ADMIN_TOKEN 即 /admin/ 登录密码（须为 ASCII，勿用中文，否则 Authorization 头会失败）
# 登录成功后浏览器只存短时会话票，不再回传主密钥
ADMIN_SESSION_HOURS=12
# 设为 0 则禁止用主密钥直接 Bearer（仅会话票）
ALLOW_RAW_ADMIN_TOKEN=1
# 审计日志路径（默认 api/data/audit.log）
# AUDIT_LOG_PATH=/app/data/audit.log
# 街机排行榜 / 画廊 clientKey 哈希盐（默认回退 ADMIN_TOKEN）
# ARCADE_HASH_SALT=

# 发布文章时自动生成 AI 摘要包（DeepSeek，与站点根目录 .env 同源）
CHATGPT_ENDPOINT=https://api.deepseek.com/v1/chat/completions
CHATGPT_ACCESS_TOKEN=
CHATGPT_MODEL=deepseek-v4-flash
# 也可用：deepseek-v4-pro

# Optional mail notify
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_TO=2274801095@qq.com
