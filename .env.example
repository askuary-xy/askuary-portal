# AI 摘要（ChatGPT 兼容接口）
# 复制本文件为 .env 后填写密钥；.env 不会提交到 git

# DeepSeek（当前默认）
CHATGPT_ENDPOINT=https://api.deepseek.com/v1/chat/completions
CHATGPT_ACCESS_TOKEN=
CHATGPT_MODEL=deepseek-v4-flash
# 也可用：deepseek-v4-pro / deepseek-chat（后者将于 2026-07-24 弃用）

# 高德地图（也可写在 data/site.json 的 amapKey / amapSecurityJsCode）
# VITE_AMAP_KEY=
# VITE_AMAP_SECURITY_JS_CODE=

# OpenAI 官方示例：
# CHATGPT_ENDPOINT=https://api.openai.com/v1/chat/completions
# CHATGPT_MODEL=gpt-4o-mini

# 可选：覆盖默认提示词 / 送入正文的最大字符数
# CHATGPT_INIT_PROMPT=（默认会一次生成 summary + selfIntro + outline 的 JSON）
# CHATGPT_MAX_CHARS=7000

# 发布流程：npm run content:build 会先 soft 跑 ai:summary
# （缺字段才请求；无密钥则跳过）
